# AgentFox for Hermes Agent. Copy to deploy/hermes/.env and fill in.

# AgentFox (generate each with: openssl rand -hex 32)
AGENTFOX_SERVICE_AUTH_SECRET=
AGENTFOX_AUDIT_SIGNING_KEY=

# The model Hermes uses. AgentFox forwards to this provider with this key; Hermes never sees it.
AGENTFOX_DEFAULT_PROVIDER=openai
AGENTFOX_OPENAI_API_KEY=
AGENTFOX_ANTHROPIC_API_KEY=
AGENTFOX_MODEL=gpt-4.1-mini

# Optional: an AgentFox agent key (Agents → hermes → Keys), so calls are attributed to it.
# Left blank, Hermes runs as an unregistered agent.
AGENTFOX_AGENT_KEY=
