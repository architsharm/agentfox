# AgentFox for OpenClaw. Copy to deploy/openclaw/.env and fill in.

# AgentFox (generate each with: openssl rand -hex 32)
AGENTFOX_SERVICE_AUTH_SECRET=
AGENTFOX_AUDIT_SIGNING_KEY=

# The model OpenClaw uses. AgentFox forwards to this provider with this key; OpenClaw never sees it.
AGENTFOX_DEFAULT_PROVIDER=openai
AGENTFOX_OPENAI_API_KEY=
AGENTFOX_ANTHROPIC_API_KEY=
AGENTFOX_MODEL=gpt-4.1-mini

# Optional: an AgentFox agent key (Agents → openclaw → Keys), so calls are attributed to it.
# Left blank, OpenClaw runs as an unregistered agent.
AGENTFOX_AGENT_KEY=

# OpenClaw's Control UI token (openssl rand -hex 24)
OPENCLAW_GATEWAY_TOKEN=
