# The public name of this machine. Point a DNS A record at it before `up`.
MODEL_SERVER_DOMAIN=models.example.com

# Shared with the gateway (AGENTFOX_MODEL_SERVER_TOKEN there too).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTFOX_MODEL_SERVER_TOKEN=

# A pinned release, so this machine changes only when you pull on purpose.
AGENTFOX_IMAGE=ghcr.io/architsharm/agentfox/gateway:latest

# auto | cpu | cuda
AGENTFOX_MODEL_DEVICE=auto
