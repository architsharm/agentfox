# Only for the bundled Caddy (`docker compose --profile caddy up -d`). With your own
# nginx, the name goes in its server block instead (README.md).
MODEL_SERVER_DOMAIN=models.example.com

# Shared with the gateway (AGENTFOX_MODEL_SERVER_TOKEN there too).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTFOX_MODEL_SERVER_TOKEN=

# Which image to run. `edge` is main. Once it works, pin what you tested so this
# machine changes only when you decide: a commit (`:sha-<7 chars>`) or a release
# (`:0.5.0`). `latest` moves only on releases and can lag main by weeks.
# Published for amd64 and arm64 (Graviton); `docker pull` picks the right one.
AGENTFOX_IMAGE=ghcr.io/architsharm/agentfox/gateway:edge

# auto | cpu | cuda
AGENTFOX_MODEL_DEVICE=auto
